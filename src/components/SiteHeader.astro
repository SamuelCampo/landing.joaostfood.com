---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
---

<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="#inicio" aria-label="Joaos Fast Food, inicio">
      <Image
        src="/assets/image-removebg-preview.png"
        alt="Joaos Fast Food"
        width={100}
        height={100}
      />
    </a>
    <nav class="nav-links" aria-label="Navegación principal">
      <a href="#menu">Menú</a>
      <a href="#combos">Promos</a>
      <a href="#visitanos">Visítanos</a>
    </nav>
    <a class="button" href="#menu"
      >Pedir ahora <span aria-hidden="true">↗</span></a
    >
  </div>
</header>
